    "/api/market/search": {
      "get": {
        "operationId": "backend_market_api_search_endpoint",
        "summary": "Search Endpoint",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "schema": {
              "title": "Q",
              "type": "string"
