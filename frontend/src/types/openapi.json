      "put": {
        "operationId": "backend_configapp_api_update_config",
        "summary": "Update Config",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigOut"
                }
              }
            }
          }
        },
        "description": "Update non-secret config (+ optional api_key). Persists to config_user.json.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConfigIn"
