{
  "openapi": "3.1.0",
  "info": {
    "title": "AlphaFlow API",
    "version": "1.0.0",
    "description": "Django backend for the AlphaFlow stock-analysis platform."
  },
  "paths": {
    "/api/core/health": {
      "get": {
        "operationId": "backend_core_api_health",
        "summary": "Health",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        },
        "description": "Liveness probe. Returns 200 if the API is up."
      }
    },
    "/api/config/": {
      "get": {
