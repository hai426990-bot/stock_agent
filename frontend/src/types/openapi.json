                  "$ref": "#/components/schemas/AnalysisDetailOut"
                }
              }
            }
          }
        },
        "description": "Full AnalysisReport (status + final_state)."
      },
      "delete": {
        "operationId": "backend_analysis_api_analysis_delete",
