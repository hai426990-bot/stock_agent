    "/api/analysis/": {
      "post": {
        "operationId": "backend_analysis_api_create_analysis",
        "summary": "Create Analysis",
        "parameters": [],
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisCreateOut"
                }
              }
            }
          }
        },
        "description": "Create an AnalysisReport, resolve the entity, and start the graph run.\n\nReturns 202 with the job_id immediately; the client then opens the SSE\nstream at GET /{job_id}/stream.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisCreateIn"
              }
            }
          },
          "required": true
        }
      },
      "get": {
        "operationId": "backend_analysis_api_analysis_list",
        "summary": "Analysis List",
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "default": 1,
              "title": "Page",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "page_size",
            "schema": {
              "default": 20,
              "title": "Page Size",
              "type": "integer"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "stock_code",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Stock Code"
            },
            "required": false
          },
          {
            "in": "query",
            "name": "status",
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            },
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AnalysisListItem"
                  },
                  "title": "Response",
                  "type": "array"
                }
              }
            }
          }
        },
        "description": "Paginated analysis history list (lightweight)."
      }
    },
    "/api/analysis/{job_id}/stream": {
      "get": {
        "operationId": "backend_analysis_api_analysis_stream",
        "summary": "Analysis Stream",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "schema": {
              "title": "Job Id",
              "type": "string"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "description": "Server-Sent Events stream of node-by-node progress.\n\nSupports Last-Event-ID / ?resume_from=<seq> for reconnect.\nEmits:\n    event: node\\ndata: {\"seq\":N,\"node\":\"...\",\"status\":\"completed|error\",\"message\":\"...\"}\n    event: done\\ndata: {\"report_id\":\"...\"}\n    event: error\\ndata: {\"node\":\"...\",\"message\":\"...\"}\n\nMust be an async view: with a sync view Django buffers the whole async\ngenerator (async_to_sync(to_list)) and the stream arrives only when the\nanalysis finishes."
      }
    },
    "/api/analysis/{job_id}": {
      "get": {
        "operationId": "backend_analysis_api_analysis_detail",
        "summary": "Analysis Detail",
        "parameters": [
          {
            "in": "path",
            "name": "job_id",
            "schema": {
              "title": "Job Id",
              "type": "string"
            },
            "required": true
