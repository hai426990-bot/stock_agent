# OpenAI API 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_API_BASE=https://api.openai.com/v1

# 支持的模型列表（按优先级排序，系统会自动探测并选择第一个可用的模型）
SUPPORTED_MODELS=gpt-4o,gpt-4-turbo,gpt-3.5-turbo,mimo-v2-flash

# 默认模型（如果 SUPPORTED_MODELS 未设置，则使用此值）
OPENAI_MODEL_NAME=gpt-4o

# 注意: 请根据您的 API 服务商支持的模型配置 SUPPORTED_MODELS
# 系统启动时会自动探测并选择第一个可用的模型

# 系统配置
PYTHONUTF8=1

# akshare 全局 HTTP 超时防护 (tools/http_timeout.py)
# 格式: "秒" 或 "连接秒,读取秒"; 默认 5,15。仅对未显式传 timeout 的请求生效。
# AKSHARE_HTTP_TIMEOUT=5,15
